# Django
SECRET_KEY=change-me-to-a-random-string
DEBUG=False
ALLOWED_HOSTS=*

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_READER_MODEL=gpt-4o-mini
OPENAI_MATCHER_MODEL=gpt-4o

# Leave blank to leave the API open. When set, every route except health
# and GET /api/vehicles/ requires the same value in the X-SFB-Key header.
SFB_API_SECRET=

# Gate cross-car fitment and watches behind a paid subscription.
PAID_GATE=False

# Stripe. Leave blank until the paid plan exists.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=https://bright-web-workshop-37.lovable.app/account?checkout=success
STRIPE_CANCEL_URL=https://bright-web-workshop-37.lovable.app/pricing?checkout=cancel

# eBay Browse API. Leave blank until the scan should call eBay.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production

# OldCarsData collector auctions. Leave blank to skip that source.
OLD_CARS_DATA_API_KEY=

# Leave EMAIL_HOST blank to print watch alerts in the server log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=alerts@sfb.app
